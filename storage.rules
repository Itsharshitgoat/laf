rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Report photos live at items/{ownerUid}/{uuid}.jpg. Reads require a
    // signed-in member; the app displays images through the Storage SDK.
    match /items/{ownerUid}/{imageId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(ownerUid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(ownerUid);
    }

    // Profile photos live at profile_images/{ownerUid}/{uuid}.jpg.
    match /profile_images/{ownerUid}/{imageId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(ownerUid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(ownerUid);
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
